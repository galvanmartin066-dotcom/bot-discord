# Token del bot de Discord (Developer Portal > tu app > Bot > Reset Token)
DISCORD_TOKEN=

# Client ID de tu aplicacion (Developer Portal > tu app > General Information > Application ID)
CLIENT_ID=

# ID de tu servidor de Discord (click derecho sobre el server con Modo Desarrollador activado > Copiar ID)
GUILD_ID=

# API key de api-football (dashboard.api-football.com)
API_FOOTBALL_KEY=

# ID de la liga en api-football. 128 = Liga Profesional Argentina
LEAGUE_ID=128

# Temporada (año). Ej: 2026
SEASON=2026

# Opcional: ID del canal donde el bot va a publicar el resumen diario de partidos.
# Si lo dejas vacio, el bot funciona igual pero sin el resumen automatico.
CHANNEL_ID=
